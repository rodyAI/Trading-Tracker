PORT=8787
FRONTEND_ORIGIN=http://localhost:5173

# yahoo uses Yahoo-compatible public endpoints and does not require an API key.
# alphavantage requires ALPHA_VANTAGE_API_KEY below.
MARKET_DATA_PROVIDER=yahoo
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query

# Lightweight backend trade database. Defaults to backend/data/trades.json when omitted.
TRADE_DATA_FILE=backend/data/trades.json

YAHOO_LANG=en-US
YAHOO_REGION=US

# Existing screener settings are kept for compatibility with the backend screener route.
SCREENER_PROVIDER=sample
SCREENER_SYMBOLS=AAPL,MSFT,GOOGL,META,TSM,ASML,AMAT,ADBE,CSCO,HIMS,PAYO,ACMR
ALPHA_VANTAGE_SYMBOLS=AAPL,MSFT,GOOGL,META,TSM
ALPHA_VANTAGE_SOFT_DAILY_LIMIT=25
